#!/usr/bin/env bash
# ============================================================
# cizen-uki-sync — Sincroniza la UKI Cizen con el ESP tras instalar
# un kernel nuevo.
#
# Replica la lógica directa de kernel-update.sh (sync_cizen_efi /
# build_cizen_uki): localiza el kernel Cizen instalado más reciente,
# prepara la línea de comandos, genera la UKI del sistema (por defecto
# arch-linux-cizen-v3.efi) y la escribe de forma atómica en todos los
# objetivos existentes del ESP.
#
# Uso:
#   sudo cizen-uki-sync               # ejecución normal (la invoca kernel-update.sh)
#   cizen-uki-sync --dry-run          # imprime todos los parámetros sin escribir
#
# Variables de entorno (override):
#   CIZEN_UKI_NAME              nombre del .efi (default arch-linux-cizen-v3.efi)
#   CIZEN_UKI_PKGBASE           pkgbase Cizen (default linux-cizen-v3)
#   CIZEN_UKI_SUFFIX            LOCALVERSION_SUFFIX (default -cizen-v3)
#   CIZEN_UKI_ALLOW_RAW_KERNEL_FALLBACK  copiar el vmlinuz pelado (default 0)
#   CIZEN_UKI_KEEP_INITRAMFS             conservar /boot/initramfs-*.img tras
#                                         integrarlo en la UKI (default 0)
#   CIZEN_UKI_ALLOW_MKINITCPIO_UKI=1     dejar que el preset de mkinitcpio
#                                         también pueda escribir la UKI
#                                         (default 0: la UKI es de este flujo)
#   CIZEN_UKI_INITRAMFS            ruta del initramfs (default
#                                         /boot/initramfs-<pkgbase>.img)
#   CIZEN_UKI_PRESET_DIR           directorio de presets de mkinitcpio
#                                         (default /etc/mkinitcpio.d)
#   CIZEN_INITRAMFS_REBUILD=0             no regenerar el initramfs con
#                                         mkinitcpio (default 1)
#   CIZEN_INITRAMFS_REQUIRED=1            abortar si no hay un initramfs válido
#                                         (default 0: se avisa y la UKI sale
#                                         sin initrd, arranque degradado)

set -Eeuo pipefail
IFS=$'\n\t'
export LC_ALL=C

CIZEN_UKI_NAME="${CIZEN_UKI_NAME:-arch-linux-cizen-v3.efi}"
CIZEN_UKI_PKGBASE="${CIZEN_UKI_PKGBASE:-linux-cizen-v3}"
CIZEN_UKI_SUFFIX="${CIZEN_UKI_SUFFIX:--cizen-v3}"
CIZEN_UKI_ALLOW_RAW_KERNEL_FALLBACK="${CIZEN_UKI_ALLOW_RAW_KERNEL_FALLBACK:-0}"
CIZEN_UKI_KEEP_INITRAMFS="${CIZEN_UKI_KEEP_INITRAMFS:-0}"
CIZEN_BOOT_TRIES="${CIZEN_BOOT_TRIES:-0}"
SIGN_REQUEST="${CIZEN_SIGN_UKI:-auto}"
SBCTL_BIN="$(command -v sbctl 2>/dev/null || true)"
# Ruta de la BD de ficheros de sbctl. Overridable para poder probar el purge
# sin tocar /var/lib/sbctl.
SBCTL_DB_FILE="${SBCTL_DB_FILE:-/var/lib/sbctl/files.json}"
DO_SIGN=false

# ── Colores ─────────────────────────────────────────────────
if [ -t 1 ]; then
  R=$'\033[0;31m'; G=$'\033[0;32m'; Y=$'\033[1;33m'; B=$'\033[0;34m'; C=$'\033[0;36m'; N=$'\033[0m'
else
  R=""; G=""; Y=""; B=""; C=""; N=""
fi

log(){  printf '%s[%s]%s %s\n' "$B" "$(date +%H:%M:%S)" "$N" "$*"; }
ok(){   printf '%s  ✓%s %s\n' "$G" "$N" "$*"; }
warn(){ printf '%s  ⚠%s %s\n' "$Y" "$N" "$*"; }
err(){  printf '%s  ✗%s %s\n' "$R" "$N" "$*" >&2; }
info(){ printf '%s  •%s %s\n' "$C" "$N" "$*"; }
fatal(){ err "$*"; exit 1; }

# Privilegios: normalmente se ejecuta bajo `sudo cizen-uki-sync`, pero si el
# usuario lo lanza sin sudo, elevamos solo los pasos que lo necesitan.
SUDO=()
if [ "$(id -u)" != 0 ]; then
  SUDO=(sudo)
fi

START_EPOCH="$(date +%s)"

find_cizen_installed_kernel() {
  local -a cand=()
  local c rel

  while IFS= read -r c; do
    [ -n "$c" ] && cand+=("$c")
  done < <(ls -1d /usr/lib/modules/*"$CIZEN_UKI_SUFFIX"/vmlinuz 2>/dev/null || true)
  while IFS= read -r c; do
    [ -n "$c" ] && cand+=("$c")
  done < <(ls -1 /boot/vmlinuz-"$CIZEN_UKI_PKGBASE" 2>/dev/null || true)
  while IFS= read -r c; do
    [ -n "$c" ] && cand+=("$c")
  done < <(ls -1 /boot/vmlinuz-*"$CIZEN_UKI_SUFFIX" 2>/dev/null || true)

  [ "${#cand[@]}" -gt 0 ] || return 1

  # El kernel recién instalado es el de mtime más reciente.
  local best="" bm=0
  for c in "${cand[@]}"; do
    local m
    m="$("${SUDO[@]}" stat -c '%Y' "$c" 2>/dev/null || echo 0)"
    if [ "$m" -gt "$bm" ]; then
      bm="$m"; best="$c"
    fi
  done
  [ "$best" != "" ] || return 1
  printf '%s\n' "$best"
}

prepare_cmdline_file() {
  local tmp
  tmp="$(mktemp /tmp/cizen-cmdline.XXXXXX)" || return 1

  if [ -s /etc/kernel/cmdline ]; then
    tr '\n' ' ' < /etc/kernel/cmdline |
      sed -E -e 's/[[:space:]]+/ /g' -e 's/^ //' -e 's/[[:space:]]$//' > "$tmp" || { rm -f "$tmp"; return 1; }
  elif [ -r /proc/cmdline ]; then
    sed -E \
      -e 's/(^|[[:space:]])BOOT_IMAGE=[^[:space:]]*//g' \
      -e 's/(^|[[:space:]])initrd=[^[:space:]]*//g' \
      -e 's/[[:space:]]+/ /g' \
      -e 's/^ //' \
      -e 's/[[:space:]]$//' \
      /proc/cmdline > "$tmp" || { rm -f "$tmp"; return 1; }
  else
    rm -f "$tmp"
    return 1
  fi

  printf '%s\n' "$tmp"
}

detect_esp_root() {
  local r fstype
  for r in /boot /efi /boot/efi; do
    [ -d "$r" ] || continue
    fstype="$(findmnt -n -M "$r" -o FSTYPE 2>/dev/null || true)"
    if [[ "$fstype" =~ ^(vfat|msdos|fuseblk)$ ]]; then
      printf '%s\n' "$r"
      return 0
    fi
  done
  return 1
}

# Objetivos = ficheros del ESP que se llaman $name, uno por cada FICHERO.
# Recorremos /boot, /efi y /boot/efi porque el ESP puede estar montado en
# cualquiera, pero eso duplica: en vfat sin CaseSensitive (el caso normal)
# /boot/efi y /boot/EFI son el MISMO directorio, y 'sort -u' solo deduplica
# cadenas, no ficheros — el UKI salía dos veces y se escribía y firmaba dos
# veces. Se deduplica por (dispositivo, inodo), que es la identidad real del
# fichero; sin stat (permiso denegado en /boot sin sudo) se degrada al nombre,
# que es el comportamiento de siempre.
#
# EL ORDEN DE LAS RAÍCES IMPORTA, y por eso empieza por /boot: cuando dos
# raíces llegan al mismo fichero gana la primera, y /boot es el punto de montaje
# real del ESP, así que gana su grafía en disco (/boot/EFI/…). Firmar la
# grafía de un alias creaba una entrada NUEVA en la BD de sbctl para un
# fichero que ya estaba inscrito con su nombre bueno: en vfat las dos rutas
# existen siempre, así que no rompe nada, pero cada sync volvía a añadir la clave
# de más. Con /boot primero se firma siempre con la misma ruta.
find_uki_targets() {
  local name="$1" r f key
  local -a found=()
  local -A seen=()

  for r in /boot /efi /boot/efi; do
    [ -d "$r" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      key="$("${SUDO[@]}" stat -c '%d:%i' -- "$f" 2>/dev/null || true)"
      if [ -n "$key" ]; then
        [ -n "${seen[$key]:-}" ] && continue
        seen[$key]="$f"
      fi
      found+=("$f")
    done < <("${SUDO[@]}" find "$r" -maxdepth 5 -type f -iname "$name" 2>/dev/null || true)
  done

  if [ "${#found[@]}" -gt 0 ]; then
    printf '%s\n' "${found[@]}" | sort -u
    return 0
  fi
  return 1
}

# ============================================================
# INITRAMFS Y UKI: UNA SOLA FUENTE DE LA VERDAD (v27.31.39)
# ============================================================
# Por qué este bloque — el UKI que arrancaba no era el que creíamos
#
# Existían DOS productores del MISMO fichero, <ESP>/EFI/Linux/<uki>.efi:
#   1. este flujo (ukify build, con nuestro .osrel y nuestro .uname)
#   2. el preset de mkinitcpio (default_uki=...), que dispara el hook
#      90-mkinitcpio-install de pacman al instalar el kernel y también con
#      `mkinitcpio -P` tras cualquier actualización de /usr/lib/initcpio/*
# Gana el último que corra, y el del hook construye la UKI con el os-release
# del sistema, con su propio .ucode y —lo grave— con el initramfs que
# encuentre en /boot, que aquí NUNCA se generaba (este proyecto no llama a
# mkinitcpio en ningún punto: su único productor era ese hook).
#
# El UKI, en cambio, se construía con la sección .ucode ENVENENADA: llevaba el
# microcode Intel en crudo (el fichero /usr/lib/firmware/intel-ucode/06-9e-09,
# tal cual) en vez de un cpio. systemd-boot le pasa al kernel .ucode + .initrd
# concatenados, y el primer byte del microcode no es ni NUL ni '0' ni una magic
# de compresión, así que unpack_to_rootfs() aborta en el primer segmento sin
# desempaquetar nada:
#     Initramfs unpacking failed: invalid magic at start of compressed archive
# Que es el error que se veía en el log. Y el equipo arranca IGUAL, porque
# btrfs y el resto van built-in a propósito (ver verify_build_tree() en el
# motor, que exige CONFIG_BTRFS_FS=y etc. "crítico para el arranque sin
# initramfs de este equipo"): el kernel monta la raíz por su cuenta. Lo que se
# pierde —udev, microcode temprano, keymap, consolefont— no se ve en el
# arranque, solo en una línea del log. Eso es exactamente lo que pasó varios
# días: un UKI roto, en silencio, en los DOS kernels.
#
# Y el diagnostico que se dio antes era equivocado, lo cual lo hizo peor: se
# culpó al initramfs "concatenado" (CPIO temprano sin comprimir con los .ko.zst
# + el microcode, y detrás el cpio comprimido), que es el diseño normal de
# mkinitcpio con zstd y que el kernel recorre sin problema, y se "arregló"
# poniendo COMPRESSION="cat" y quitando el hook 'microcode'. Ese arreglo no
# tocaba la causa, y con el validador equivocado se dio por bueno. Por eso aquí
# la validación se hace con el mismo bucle de segmentos del kernel, y la
# sección .ucode se comprueba aparte.
#
# El flujo se cierra en tres puntos:
#   1. cizen_uki_claim_preset()   el preset deja de construir la UKI y se
#      queda solo con el initramfs. La UKI es de este flujo y de nadie más.
#   2. cizen_initramfs_prepare()  se REGENERA con mkinitcpio y se VALIDA antes
#      de embeberla, recorriendo los segmentos como el kernel: el concatenado
#      de mkinitcpio pasa, y en cambio se rechazan la corrupción, el truncamiento
#      y un microcode crudo por delante.
#   3. cizen_uki_verify_image()   se comprueba la UKI ya construida: la
#      sección .initrd tiene que medir exactamente lo que mide el initramfs
#      validado (ukify lo mete tal cual), y sin initramfs se dice en voz alta
#      que el arranque va a ser degradado.

# Devuelve 1 si este equipo puede producir su UKI él solo. Con
# CIZEN_UKI_ALLOW_MKINITCPIO_UKI=1 se deja el preset como estaba.
cizen_uki_claim_preset() {
  local preset image
  preset="${CIZEN_UKI_PRESET_DIR:-/etc/mkinitcpio.d}/${CIZEN_UKI_PKGBASE}.preset"
  image="$(cizen_initramfs_path)"

  if [ "${CIZEN_UKI_ALLOW_MKINITCPIO_UKI:-0}" = "1" ]; then
    info "CIZEN_UKI_ALLOW_MKINITCPIO_UKI=1: el preset de mkinitcpio puede volver a escribir ${CIZEN_UKI_NAME}."
    return 0
  fi

  "${SUDO[@]}" test -f "$preset" || {
    info "Sin preset de mkinitcpio para ${CIZEN_UKI_PKGBASE}: nada que reclamar."
    return 0
  }

  if ! "${SUDO[@]}" grep -qE '^[[:space:]]*[A-Za-z0-9_]+_uki=' "$preset"; then
    return 0
  fi

  # El original se conserva una sola vez, para poder revertir a mano.
  "${SUDO[@]}" test -f "$preset.cizen-orig" ||
    "${SUDO[@]}" cp -a -- "$preset" "$preset.cizen-orig" || true

  # 1) La UKI deja de ser cosa del preset. Se comenta con un marcador propio
  #    para que quede claro en el fichero quién lo decidió y por qué.
  "${SUDO[@]}" sed -i -E \
    's|^([[:space:]]*)([A-Za-z0-9_]+_uki=)|\1#CIZEN-UKI-OWNED \2|' "$preset"

  # 2) Y el preset tiene que seguir produciendo ALGO, o mkinitcpio se queja de
  #    "No image or UKI specified" y el hook de pacman deja de hacer su parte.
  #    Que produzca el initramfs: esa es la división (preset = initramfs,
  #    este flujo = UKI).
  image="/boot/initramfs-${CIZEN_UKI_PKGBASE}.img"
  if ! "${SUDO[@]}" grep -qE '^[[:space:]]*[A-Za-z0-9_]+_image=' "$preset"; then
    if "${SUDO[@]}" grep -qE '^[[:space:]]*#[[:space:]]*[A-Za-z0-9_]+_image=' "$preset"; then
      "${SUDO[@]}" sed -i -E \
        's|^([[:space:]]*)#[[:space:]]*([A-Za-z0-9_]+_image=)|\1\2|' "$preset"
    else
      printf 'default_image="%s"\n' "$image" | "${SUDO[@]}" tee -a "$preset" >/dev/null
    fi
  fi

  ok "Preset de mkinitcpio recortado a initramfs: ya no construye la UKI (la escribe ${CIZEN_UKI_NAME})."
  info "  Original en $preset.cizen-orig · initramfs en $image"
  return 0
}

# Ruta del initramfs que produce el preset de mkinitcpio. Overridable para
# poder ejercitar la validacion sin /boot (y para quien lo tenga en otro sitio).
cizen_initramfs_path() {
  printf '%s\n' "${CIZEN_UKI_INITRAMFS:-/boot/initramfs-${CIZEN_UKI_PKGBASE}.img}"
}

# Recorre una imagen initrd como lo hace el kernel y dice si encuentra /init.
#
# POR QUE NO BASTABA CON MIRAR EL PRIMER cpio
#
# init/initramfs.c:unpack_to_rootfs() (7.2.8) no espera un unico archivo: va
# recorriendo la imagen en segmentos mientras queden bytes, y en cada vuelta
#   - si el byte es NUL, lo salta (el relleno de alineacion que pone mkinitcpio)
#   - si empieza por '0' y el offset cae alineado a 4, lo desempaqueta como cpio
#   - si no, busca una magic de compresion conocida y lo descomprime
#   - si no hay ninguna de las dos: "invalid magic at start of compressed
#     archive" y PARA, dejando lo ya desempaquetado como estaba
#
# O sea que el diseno normal de mkinitcpio con zstd --meter en un CPIO temprano
# sin comprimir lo que no quiere comprimir dos veces (los .ko.zst, el firmware y
# el microcode del hook 'microcode') y concatenar detras el cpio comprimido-- es
# un initramfs perfectamente valido, con el kernel encontrando /init en el
# segundo segmento. Una version anterior de este script exigia que el PRIMER
# cpio trajera 'init', rechazaba ese layout legitimo y recetaba
# COMPRESSION="cat" como arreglo. Ese diagnostico era FALSO, y el arreglo era
# ademas inutil: con 'cat' el CPIO temprano sigue ahi, solo que sin comprimir.
# Peor: con el mismo validador se "verifico" un arreglo que no tocaba la causa
# real, y el equipo siguio arrancando sin initramfs durante dias.
#
# Lo que si tumbaba el arranque era otra cosa, y esta funcion tambien lo pilla
# porque es el mismo bucle: un blob de microcode Intel CRUDO delante. Va en la
# seccion .ucode de la UKI, y lo comprueba cizen_uki_verify_image().
#
# python3 porque es lo que necesita ukify igual, asi que no es una dependencia
# nueva. Si no esta, se avisa y se sigue: seria un fallo de este script, no del
# arranque.
cizen_initramfs_walk() {
  python3 - "$1" <<'CIZEN_INITRD_WALK_PY'
import bz2, gzip, lzma, subprocess, sys

CPIO = (b"070701", b"070702")
# Ojo: ningun '}' puede quedar en la columna 0 de este bloque, porque el
# selftest extrae las funciones con sed -n '/^fn() {/,/^}/p' y un cierre de
# dict o lista ahi le cortaria la funcion por la mitad.
DEC = {"gzip": ["gzip", "-dc"], "bzip2": ["bzip2", "-dc"],
     "xz": ["xz", "-dc"], "lzma": ["xz", "-dc"],
     "lz4": ["lz4", "-dcq"], "lzo": ["lzop", "-dc"],
     "zstd": ["zstd", "-dcq"]}
MAGIC = [
  (b"\x1f\x8b", "gzip"), (b"BZh", "bzip2"), (b"\x5d\x00\x00\x80", "lzma"),
  (b"\xfd7zXZ\x00", "xz"), (b"\x89LZO\x00", "lzo"),
  (b"\x02\x21\x4c\x18", "lz4"), (b"\x28\xb5\x2f\xfd", "zstd"),
]


def entries(buf, off):
  """Nombres del cpio newc que empieza en off, y su longitud en bytes."""
  names, pos = [], off
  while pos + 110 <= len(buf):
      try:
          nsz = int(buf[pos + 94:pos + 102], 16)
          fsz = int(buf[pos + 54:pos + 62], 16)
      except ValueError:
          break
      hdr = 110 + nsz
      hdr += (-hdr) % 4
      name = buf[pos + 110:pos + 110 + nsz].rstrip(b"\x00").decode("utf-8", "replace")
      if name == "TRAILER!!!":
          return names, pos + hdr - off
      names.append(name)
      pos += hdr + fsz + ((-fsz) % 4)
  return names, None


def microcode(buf, off):
  """Longitud de un blob de microcode Intel crudo en off, o None.

  Cabecera de Intel: 0x00 version (LE, =1), 0x1C tamano total (LE). El 0x04
  NO es el tamano, es la fecha en BCD, asi que no se puede usar para esto.
  """
  if off + 0x20 > len(buf):
      return None
  ver = int.from_bytes(buf[off:off + 4], "little")
  total = int.from_bytes(buf[off + 0x1C:off + 0x20], "little")
  if ver == 1 and 0x100 <= total <= len(buf) - off:
      return total
  return None


def inflate(kind, data):
  try:
      if kind == "gzip":
          return gzip.decompress(data)
      if kind == "bzip2":
          return bz2.decompress(data)
      if kind in ("xz", "lzma"):
          return lzma.decompress(data)
  except Exception as exc:
      print("  %s: %s" % (kind, exc))
      return None
  if kind not in DEC:
      return None
  p = subprocess.run(DEC[kind], input=data, stdout=subprocess.PIPE,
                     stderr=subprocess.PIPE)
  if p.returncode:
      print("  %s: %s" % (kind, p.stderr.decode("utf-8", "replace").strip()))
      return None
  return p.stdout


def main():
  try:
      with open(sys.argv[1], "rb") as fh:
          buf = fh.read()
  except OSError as exc:
      print("no-leo: %s" % exc)
      return 2
  if not buf:
      print("la imagen no tiene bytes")
      return 1

  off, segs, nuls, stop, found = 0, [], 0, None, False
  while off < len(buf):
      if buf[off] == 0:
          off += 1
          nuls += 1
          continue
      if buf[off:off + 6] in CPIO and off % 4 == 0:
          names, length = entries(buf, off)
          if length is None:
              stop = (off, "cpio truncado: no aparece TRAILER!!!")
              break
          segs.append("cpio @%d: %d B, %d entradas%s"
                      % (off, length, len(names),
                         ", trae /init" if "init" in names else ""))
          if "init" in names:
              found = True
          off += length
          continue
      kind = next((k for m, k in MAGIC if buf[off:off + len(m)] == m), None)
      if kind is None:
          stop = (off, "invalid magic at start of compressed archive")
          break
      raw = inflate(kind, buf[off:])
      if raw is None:
          stop = (off, "no se pudo descomprimir")
          break
      names, _ = entries(raw, 0)
      segs.append("%s @%d: %d B -> %d B, %d entradas%s"
                  % (kind, off, len(buf) - off, len(raw), len(names),
                     ", trae /init" if "init" in names else ""))
      if "init" in names:
          found = True
      off = len(buf)

  for s in segs:
      print("segmento: %s" % s)
  if nuls:
      print("relleno NUL entre segmentos: %d B (el kernel los salta uno a uno)" % nuls)
  if stop:
      print("el kernel PARA en @%d: %s" % stop)
      print("bytes ahi: %s" % buf[stop[0]:stop[0] + 16].hex(" "))
      mc = microcode(buf, stop[0])
      if mc:
          print("diagnostico: esto no es un initramfs, es un blob de microcode Intel")
          print("crudo de %d bytes. El kernel recibe .ucode + .initrd concatenados y" % mc)
          print("aborta antes de desempaquetar NADA. Va en la seccion .ucode de la UKI,")
          print("no aqui: mira cizen_uki_verify_image().")
  if found and not stop:
      print("veredicto: el kernel encuentra /init")
      return 0
  if found:
      print("veredicto: /init esta en la imagen pero el kernel se detiene antes")
      return 1
  print("veredicto: el kernel se queda SIN /init")
  return 1


sys.exit(main())
CIZEN_INITRD_WALK_PY
}

# Valida que la imagen sea un initramfs que este kernel sabe desempaquetar.
# El test decisivo es el del kernel: recorrer los segmentos y encontrar /init en
# alguno. Asi cae, sin falsos positivos ni falsos negativos:
#   - cpio unico con 'init'                               -> vale;
#   - CPIO temprano + cpio comprimido (lo normal con zstd) -> vale;
#   - lo mismo sin alinear el segundo a 4 bytes           -> no vale, y avisa,
#     porque el alineamiento a 4 es justo lo que el kernel exige para el salto
#     de segmento;
#   - microcode crudo delante, imagen corrupta o truncada -> no vale.
cizen_initramfs_validate() {
  local img="$1" out rc
  
  if [ ! -s "$img" ]; then
    err "El initramfs '$img' no existe o esta vacio."
    return 1
  fi
  
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 no esta instalado: no puedo comprobar el contenido de '$img'."
    return 0
  fi
  
  out="$(cizen_initramfs_walk "$img" 2>&1)"
  rc=$?
  printf '%s\n' "$out" | sed 's/^/  /'
  
  if [ "$rc" -eq 0 ]; then
    ok "Initramfs validado: $img (el kernel encuentra /init)"
    return 0
  fi
  if [ "$rc" -eq 2 ]; then
    warn "No pude recorrer '$img': lo doy por bueno sin comprobarlo."
    return 0
  fi
  
  err "El initramfs '$img' NO sirve: el kernel no llegaria a /init (detalle arriba)."
  err "  El equipo arrancaria igual (btrfs va built-in) pero SIN initramfs: sin"
  err "  /init, sin udev, sin microcode temprano y sin keymap, y en silencio."
  err "  Si el detalle dice 'microcode Intel crudo', el problema no esta aqui sino"
  err "  en la seccion .ucode de la UKI: mira cizen_uki_verify_image()."
  err "  Arreglo: regenera con 'mkinitcpio -p ${CIZEN_UKI_PKGBASE:-<pkgbase>}' y vuelve a validar."
  return 1
}

# Regenera el initramfs con mkinitcpio y lo valida. Deja la ruta utilizable
# en INITRAMFS_PATH (vacía si no hay ninguna). Devuelve 1 si no se pudo
# obtener un initramfs válido; entonces es el llamante quien decide si eso
# es tolerable (CIZEN_INITRAMFS_REQUIRED) o si sigue sin initrd avisando.
#
# No se imprime la ruta por stdout a propósito: las funciones de log de este
# script escriben ahí, y el valor acabaría mezclado con sus mensajes.
INITRAMFS_PATH=""
cizen_initramfs_prepare() {
  local path
  path="$(cizen_initramfs_path)"

  if [ "${CIZEN_INITRAMFS_REBUILD:-1}" = "0" ]; then
    info "CIZEN_INITRAMFS_REBUILD=0: no regenero el initramfs."
  elif ! command -v mkinitcpio >/dev/null 2>&1; then
    warn "mkinitcpio no está instalado: no puedo regenerar el initramfs."
  elif ! "${SUDO[@]}" test -f "${CIZEN_UKI_PRESET_DIR:-/etc/mkinitcpio.d}/${CIZEN_UKI_PKGBASE}.preset"; then
    warn "No hay preset de mkinitcpio para ${CIZEN_UKI_PKGBASE}: no regenero el initramfs."
  else
    log "Regenerando el initramfs (mkinitcpio -p ${CIZEN_UKI_PKGBASE})"
    if "${SUDO[@]}" mkinitcpio -p "$CIZEN_UKI_PKGBASE"; then
      ok "Initramfs regenerado: $path"
    else
      err "mkinitcpio -p ${CIZEN_UKI_PKGBASE} falló."
    fi
  fi

  if [ ! -s "$path" ]; then
    err "No hay initramfs en $path."
    return 1
  fi

  if cizen_initramfs_validate "$path"; then
    INITRAMFS_PATH="$path"
    return 0
  fi
  return 1
}

# Comprueba la UKI recién construida contra el initramfs validado. ukify mete
# el fichero tal cual en la sección .initrd, así que el tamaño de la sección
# tiene que coincidir con el del fichero: si no, lo que va a leer el kernel
# no es lo que se validó (y si no hay initramfs, tiene que avisar de que el
# arranque será degradado, no dejarlo pasar en silencio).
cizen_uki_verify_image() {
  local uki="$1" initrd="${2:-}" hex size isize

  if ! command -v objdump >/dev/null 2>&1; then
    warn "objdump no está instalado: no puedo comprobar la sección .initrd de la UKI."
    return 0
  fi

  hex="$(objdump -h -- "$uki" 2>/dev/null | awk '$2 == ".initrd" { print $3; exit }')" || hex=""
  if [ -n "$hex" ]; then
    size=$((16#$hex))
  else
    size=""
  fi

  # .ucode, si lo hay, TIENE que ser un cpio. ukify y objcopy meten el fichero
  # tal cual en la seccion, y el kernel concatena .ucode + .initrd antes de
  # desempaquetar: si lo que va delante no es un cpio --un blob de microcode
  # crudo, tipicamente-- el primer byte no es ni NUL ni '0' ni una magic de
  # compresion, el kernel aborta con "invalid magic at start of compressed
  # archive" y NO desempaqueta nada: ni /init, ni udev, ni el microcode que si
  # venia dentro del .initrd. Ese fallo silencioso tumbo los dos kernels de
  # este equipo durante dias, y ninguna comprobacion sobre el fichero de
  # initramfs podia verlo, porque el .ucode es otra seccion de la UKI.
  ucode_hex="$(objdump -h -- "$uki" 2>/dev/null | awk '$2 == ".ucode" { print $3; exit }')" || ucode_hex=""
  if [ -n "$ucode_hex" ]; then
    ucode_tmp="$(mktemp "${TMPDIR:-/tmp}/cizen-ucode.XXXXXX")"
    if objcopy --dump-section ".ucode=$ucode_tmp" -- "$uki" 2>/dev/null && [ -s "$ucode_tmp" ]; then
      if head -c 6 -- "$ucode_tmp" | grep -qE '^(070701|070702)$'; then
        ok "UKI verificada: .ucode de $((16#$ucode_hex)) bytes, es un cpio"
      else
        err "La seccion .ucode de la UKI no es un cpio newc (empieza en $(head -c 8 -- "$ucode_tmp" | od -An -tx1 | tr -d ' \n'))."
        err "  Es casi siempre el microcode Intel en crudo. El kernel recibe .ucode +"
        err "  .initrd concatenados, aborta el desempaquetado entero con 'invalid magic"
        err "  at start of compressed archive' y se queda sin /init, sin udev y sin"
        err "  microcode. Viene de Microcode= en /etc/kernel/uki.conf apuntando a un"
        err "  fichero de /usr/lib/firmware/intel-ucode/ en vez de a un cpio: ukify"
        err "  lo mete tal cual. Con initrd no hace falta, el microcode ya va en el"
        err "  CPIO temprano del initramfs. No escribo la UKI."
        rm -f -- "$ucode_tmp"
        return 1
      fi
    else
      warn "No pude extraer la seccion .ucode de la UKI: no la compruebo."
    fi
    rm -f -- "$ucode_tmp"
  fi
  
  if [ -z "$initrd" ]; then
    if [ -n "$size" ]; then
      warn "La UKI lleva un .initrd de $size bytes sin haber validado ningún initramfs."
    else
      warn "La UKI no lleva .initrd: el equipo arrancará SIN initramfs (sin /init, sin udev,"
      warn "  sin microcode temprano y sin keymap). Sigue siendo un arranque válido porque"
      warn "  btrfs y el resto van built-in, pero es un arranque degradado."
    fi
    return 0
  fi

  isize="$("${SUDO[@]}" stat -c '%s' -- "$initrd" 2>/dev/null || echo 0)"
  if [ "$isize" -eq 0 ] 2>/dev/null; then
    err "No pude leer el tamaño de $initrd: no puedo verificar la UKI."
    return 1
  fi
  if [ -z "$size" ]; then
    err "La UKI no tiene sección .initrd pero se iba a embeber $initrd: no la escribo."
    return 1
  fi
  if [ "$size" -ne "$isize" ]; then
    err "La sección .initrd de la UKI mide $size bytes y el initramfs validado $isize."
    err "  Lo que arranque el kernel no es la imagen que se ha validado: no la escribo."
    return 1
  fi

  ok "UKI verificada: .initrd de $size bytes = $initrd"
  return 0
}

build_uki() {
  local kernel="$1" cmdline_file="$2" out="$3"
  local cmdline_text ukify_bin stub s initrd used_initrd="" osrel_file="" rel=""

  cmdline_text="$(<"$cmdline_file")"

  # os-release propio embebido en la UKI (.osrel) para que systemd-boot
  # muestre "Linux <release>" en el menú (p. ej. "Linux 7.2.7-cizen-v3").
  # Sin --os-release, ukify incrusta /etc/os-release por defecto y el menú
  # mostraría el nombre del sistema ("Arch Linux (Rolling)"). Replica
  # build_cizen_uki() de kernel-update.sh.
  rel="$(basename -- "$(dirname -- "$kernel")")"
  if [[ "$rel" != *"$CIZEN_UKI_SUFFIX" ]]; then
    rel=""
    while IFS= read -r d; do
      [ -n "$d" ] && rel="$(basename -- "$d")" && break
    done < <(ls -1d /usr/lib/modules/*"$CIZEN_UKI_SUFFIX" 2>/dev/null || true)
  fi
  if [[ "$rel" == *"$CIZEN_UKI_SUFFIX" ]]; then
    osrel_file="$(mktemp /tmp/cizen-osrel.XXXXXX)" || osrel_file=""
    if [ -n "$osrel_file" ]; then
      {
        printf 'NAME="Linux"\n'
        printf 'ID=linux\n'
        printf 'VERSION="%s"\n' "$rel"
        printf 'VERSION_ID="%s"\n' "$rel"
        printf 'PRETTY_NAME="Linux %s"\n' "$rel"
      } > "$osrel_file"
      info "os-release UKI: PRETTY_NAME=Linux $rel"
    fi
  fi

  ukify_bin="$(command -v ukify 2>/dev/null || true)"
  if [ -z "$ukify_bin" ] && [ -x /usr/lib/systemd/ukify ]; then
    ukify_bin="/usr/lib/systemd/ukify"
  fi

  if [ -n "$ukify_bin" ]; then
    local -a args=("$ukify_bin" build --linux="$kernel" --cmdline="$cmdline_text" --output="$out")
    if [ -n "$osrel_file" ]; then
      args+=(--os-release=@"$osrel_file")
    fi
    # --uname fija la versión del kernel en la UKI (sección .uname). Sin esto
    # ukify la autodetecta y avisa ("Kernel version not specified, starting
    # autodetection 😖"): en multi-kernel puede quedarse con otra versión, y la
    # UKI se firma antes de que exista el /lib/modules definitivo. OJO: el flag
    # es --uname, no --version (este último imprime la versión de ukify y sale).
    if [ -n "$rel" ]; then
      args+=(--uname="$rel")
    fi
    # El initramfs se regenera y valida AQUÍ, no antes: build_uki es la única
    # puerta por la que pasa todo initrd que acabe dentro de una UKI, así que
    # es aquí donde tiene que estar la comprobación. Antes se embebía el
    # fichero que hubiera en /boot sin mirarlo: si no había ninguno la UKI
    # salía sin initrd sin decir nada, y si había uno corrupto, truncado o de
    # otra versión se embebía igual.
    local initrd=""
    local have_initrd=0
    if cizen_initramfs_prepare; then
      initrd="$INITRAMFS_PATH"
      have_initrd=1
    elif [ "${CIZEN_INITRAMFS_REQUIRED:-0}" = "1" ]; then
      err "No hay initramfs válido y CIZEN_INITRAMFS_REQUIRED=1: no construyo la UKI."
      return 1
    else
      # El diseño del motor es que el equipo arranca igual sin initramfs
      # (btrfs y el resto built-in; ver verify_build_tree()), así que se
      # sigue, pero nunca en silencio.
      warn "Sin initramfs válido: la UKI saldrá sin initrd y el arranque será degradado."
    fi
    if [ "$have_initrd" -eq 1 ]; then
      args+=(--initrd="$initrd")
      used_initrd="$initrd"
      ok "Incluyendo initramfs: $initrd"
    fi
    # Microcódigo Intel temprano: solo se inyecta vía --microcode si NO hay
    # initrd (kernel standalone). Con initrd, el hook 'microcode' de
    # mkinitcpio (intel-ucode) ya lo incluye en el CPIO del initramfs.
    if [ "$have_initrd" -eq 0 ]; then
      # Microcódigo Intel temprano (early microcode CPIO) embebido en la UKI.
      # Sin esto ukify no incluye la actualización de microcódigo y el kernel
      # arranca con la revisión de la BIOS (más antigua), dejando expuestas
      # vulnerabilidades de ejecución especulativa (Downfall/GDS, MDS, etc.).
      # Se genera un CPIO mínimo con el blob específico para el CPUID de la CPU.
      local ucode_tmp="" ucode_dir="" cpuid_hex="" ucode_bin="" ucode_rev=""
      cpuid_hex="$(awk -F': ' '\
        /vendor_id/   { vend=$2 }\
        /cpu family/  { fam=sprintf("%02x",$2+0) }\
        /^model[[:space:]]*:/ { mod=sprintf("%02x",$2+0) }\
        /stepping/    { step=sprintf("%02x",$2+0) }\
        END { if (vend~/Intel/) printf "%s-%s-%s",fam,mod,step }\
      ' /proc/cpuinfo)"
      ucode_bin="/usr/lib/firmware/intel-ucode/${cpuid_hex}"
      if [ -f "$ucode_bin" ]; then
        ucode_dir="$(mktemp -d /tmp/cizen-ucode-dir.XXXXXX)" && \
        ucode_tmp="$(mktemp /tmp/cizen-ucode.XXXXXX)" && {
          mkdir -p "$ucode_dir/kernel/x86/microcode"
          cp "$ucode_bin" "$ucode_dir/kernel/x86/microcode/GenuineIntel.bin"
          (cd "$ucode_dir" && find . -mindepth 1 | sort | \
            cpio -o -H newc --reproducible 2>/dev/null) > "$ucode_tmp"
          rm -rf "$ucode_dir"
          args+=(--microcode="$ucode_tmp")
          ucode_rev="$(od -An -tx4 -j4 -N4 "$ucode_bin" | tr -d ' \n')"
          ok "Microcodigo Intel (standalone): CPUID=${cpuid_hex} rev=0x${ucode_rev}"
        } || {
          warn "No pude generar CPIO de microcodigo; continuando sin el."
          rm -rf "$ucode_dir" 2>/dev/null; ucode_tmp=""
        }
      fi
    else
      ok "Microcodigo Intel: ya va en el initramfs (hook microcode de mkinitcpio)"
    fi
    if "${args[@]}"; then
      [ -n "$osrel_file" ] && rm -f "$osrel_file"
      [ -n "$ucode_tmp" ] && rm -f "$ucode_tmp"
      embedded_initrd="$used_initrd"
      return 0
    fi
    [ -n "$ucode_tmp" ] && rm -f "$ucode_tmp"
  fi

  stub=""
  for s in /usr/lib/systemd/boot/efi/linuxx64.efi.stub /usr/lib/gummiboot/linuxx64.efi.stub; do
    if [ -s "$s" ]; then
      stub="$s"
      break
    fi
  done

  if [ -n "$stub" ] && command -v objcopy >/dev/null 2>&1; then
    local -a objargs=(
      --add-section .cmdline="$cmdline_file"
      --set-section-flags .cmdline=noload,readonly
    )
    if [ -n "$osrel_file" ]; then
      objargs+=(--add-section .osrel="$osrel_file")
      objargs+=(--set-section-flags .osrel=noload,readonly)
    fi
    objargs+=(--add-section .linux="$kernel")
    objargs+=(--set-section-flags .linux=noload,readonly)
    if objcopy "${objargs[@]}" "$stub" "$out"; then
      [ -n "$osrel_file" ] && rm -f "$osrel_file"
      return 0
    fi
  fi

  [ -n "$osrel_file" ] && rm -f "$osrel_file"

  if [ "$CIZEN_UKI_ALLOW_RAW_KERNEL_FALLBACK" = 1 ]; then
    cp -f "$kernel" "$out"
    return 0
  fi

  return 1
}

# Nombre real del .efi en el ESP. Plano por defecto (CIZEN_BOOT_TRIES=0): el
# nombre con contador +N lo renombra systemd-bless-boot al completar el
# arranque y eso deja entradas huérfanas en la BD de sbctl que matan el hook
# de pacman (ver "POR QUÉ CIZEN_BOOT_TRIES=0" en la cabecera).
uki_efi_name() {
  local base="${CIZEN_UKI_NAME%.efi}"
  if [ "${CIZEN_BOOT_TRIES:-0}" -gt 0 ]; then
    printf '%s+%s.efi\n' "$base" "${CIZEN_BOOT_TRIES}"
  else
    printf '%s\n' "$CIZEN_UKI_NAME"
  fi
}

# Borra las variantes que NO son el nombre actual (la plana bendecida por
# systemd-bless-boot y los contadores +N de boots anteriores) para que tras
# cada sincronización solo quede la UKI vigente. Con el nombre plano activo,
# esto elimina cualquier +N que hubiera quedado de un build con boot counting.
# Deduplica por inodo como find_uki_targets: /boot/efi y /boot/EFI son el mismo
# directorio en vfat, así que sin esto cada variante se borraba dos veces.
cleanup_uki_variants() {
  local base current r f key
  local -A seen=()
  base="${CIZEN_UKI_NAME%.efi}"
  current="$(uki_efi_name)"
  for r in /boot /efi /boot/efi; do
    [ -d "$r" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ "$(basename -- "$f")" = "$current" ] && continue
      key="$("${SUDO[@]}" stat -c '%d:%i' -- "$f" 2>/dev/null || true)"
      if [ -n "$key" ]; then
        [ -n "${seen[$key]:-}" ] && continue
        seen[$key]="$f"
      fi
      "${SUDO[@]}" rm -f -- "$f" 2>/dev/null || true
    done < <("${SUDO[@]}" find "$r" -maxdepth 5 -type f \( -name "${base}.efi" -o -name "${base}+*.efi" \) 2>/dev/null || true)
  done
}

targets_are_current() {
  local cutoff=$((START_EPOCH - 2))
  local f mtime any=false
  while IFS= read -r f; do
    mtime="$("${SUDO[@]}" stat -c '%Y' "$f" 2>/dev/null || echo 0)"
    [ "$mtime" -gt 0 ] || continue
    any=true
    if [ "$mtime" -lt "$cutoff" ]; then
      return 1
    fi
  done < <(find_uki_targets "$(uki_efi_name)" || true)
  [ "$any" = true ]
}

# Secure Boot habilitado en el firmware: variable UEFI SecureBoot (byte 4 de
# valor; 01 = activo). Los sysfs efivar son legibles por el usuario; si no,
# se reintenta elevando.
secure_boot_active() {
  local val
  val="$(od -An -j4 -N1 -tu1 \
      "/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c" \
      2>/dev/null | tr -d '[:space:]' || true)"
  if [ -z "$val" ] && [ "${#SUDO[@]}" -gt 0 ]; then
    val="$("${SUDO[@]}" od -An -j4 -N1 -tu1 \
        "/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c" \
        2>/dev/null | tr -d '[:space:]' || true)"
  fi
  [ "$val" = "1" ]
}

sign_uki_targets() {
  local t fail=0
  [ -n "$SBCTL_BIN" ] || { warn "sbctl no está instalado; no se puede firmar la UKI."; return 1; }
  # --save: desde sbctl 0.18 firmar NO registra la firma en la BD de sbctl;
  # sin --save el hook de pacman (sbctl sign-all) no re-firma la UKI en
  # actualizaciones y sbctl verify deja de reconocerla.
  for t in "$@"; do
    if "${SUDO[@]}" sbctl sign --save "$t" >/dev/null 2>&1; then
      ok "Firmada con sbctl: $t"
    else
      err "sbctl sign falló: $t"
      fail=1
    fi
  done
  [ "$fail" -eq 0 ] || return 1
  for t in "$@"; do
    if "${SUDO[@]}" sbctl verify "$t" >/dev/null 2>&1; then
      ok "Firma verificada: $t"
    else
      err "La verificación de la firma falló: $t"
      fail=1
    fi
  done
  return "$fail"
}

# Claves sbctl ya generadas (sbctl create-keys). Firmar sin claves fallaría.
sbctl_keys_present() {
  "${SUDO[@]}" test -s /var/lib/sbctl/keys/db/db.key 2>/dev/null && \
  "${SUDO[@]}" test -s /var/lib/sbctl/keys/PK/PK.key 2>/dev/null && \
  "${SUDO[@]}" test -s /var/lib/sbctl/keys/KEK/KEK.key 2>/dev/null
}

# Entradas de la BD de sbctl cuyo fichero ya no existe. Esas entradas son la
# causa del fallo de pacman: 'sbctl sign-all' (hook zzz-sbctl.hook) aborta con
# "does not exist" y el -Syu termina en error. Sin argumentos = todas.
sbctl_stale_entries() {
  local db="${1:-$SBCTL_DB_FILE}" f
  [ -r "$db" ] || return 0
  # Claves del objeto JSON de primer nivel ("ruta": { ... }). Es la forma más
  # robusta de extraerlas sin depender de jq ni de un parser propio: las líneas
  # indented de "file"/"output_file" no encajan con el patrón porque detrás de
  # los dos puntos no hay '{'.
  while IFS= read -r f; do
    f="${f#"${f%%[![:space:]]*}"}"   # quite espacios iniciales
    f="${f%"${f##*[![:space:]]}"}"   # quite espacios finales
    f="${f%\"}"; f="${f#\"}"          # quite comillas
    [ -n "$f" ] || continue
    [ "$f" = "$db" ] && continue
    "${SUDO[@]}" test -e "$f" 2>/dev/null || printf '%s\n' "$f"
  done < <(sed -n 's/^[[:space:]]*"\([^"]*\)"[[:space:]]*:[[:space:]]*{.*/\1/p' "$db" 2>/dev/null || true)
}

# Purga de la BD de sbctl: quita las entradas cuyo fichero ya no está (UKIs +N
# renombradas por systemd-bless-boot, UKIs retiradas, vmlinuz borrados). Sin
# esto, cualquier transacción de pacman que toque /boot falla. Idempotente, y
# solo toca entradas huérfanas: nunca las que existen.
sbctl_prune_stale() {
  local -a stale=()
  local f n=0
  [ -n "$SBCTL_BIN" ] || return 0
  while IFS= read -r f; do
    [ -n "$f" ] && stale+=("$f")
  done < <(sbctl_stale_entries "${1:-$SBCTL_DB_FILE}")

  [ "${#stale[@]}" -gt 0 ] || return 0
  for f in "${stale[@]}"; do
    if "${SUDO[@]}" "$SBCTL_BIN" remove-file "$f" >/dev/null 2>&1; then
      n=$((n + 1))
    fi
  done
  if [ "$n" -gt 0 ]; then
    ok "BD de sbctl saneada: $n entrada(s) huérfana(s) eliminadas (sbctl remove-file)."
    for f in "${stale[@]}"; do
      [ -e "$f" ] || info "  - $f (ya no existe; estorbaba a sbctl sign-all en pacman)"
    done
  fi
  return 0
}

# Decide DO_SIGN a partir de CIZEN_SIGN_UKI / --sign / --no-sign. auto firma
# SIEMPRE con Secure Boot activo (fail-safe: una UKI sin firmar no arrancaría).
resolve_sign_request() {
  case "$SIGN_REQUEST" in
    yes)
      DO_SIGN=true
      ok "Firma de la UKI con sbctl forzada (--sign / CIZEN_SIGN_UKI=yes)."
      return 0
      ;;
    no)
      if secure_boot_active; then
        fatal "CIZEN_SIGN_UKI/--no-sign pide NO firmar pero Secure Boot está ACTIVO: la UKI sin firmar no arrancaría."
      fi
      info "Firma de la UKI desactivada (--no-sign / CIZEN_SIGN_UKI=no)."
      return 0
      ;;
  esac
  if [ -z "$SBCTL_BIN" ]; then
    if secure_boot_active; then
      fatal "Secure Boot está ACTIVO y sbctl no está instalado: la UKI sin firmar no arrancaría. Instala sbctl (sudo pacman -S sbctl)."
    fi
    info "sbctl no detectado: la UKI no se firmará."
    return 0
  fi
  if secure_boot_active; then
    DO_SIGN=true
    ok "Secure Boot ACTIVO: la UKI se firmará con sbctl (obligatorio)."
  else
    info "sbctl disponible pero Secure Boot desactivado: la UKI no se firmará (--sign para forzar)."
  fi
  return 0
}

DRY_RUN=0
SIGN_REQUEST="${CIZEN_SIGN_UKI:-auto}"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --sign) SIGN_REQUEST="yes"; shift ;;
    --no-sign) SIGN_REQUEST="no"; shift ;;
    *) break ;;
  esac
done
case "$SIGN_REQUEST" in
  yes|no|auto) ;;
  *) err "CIZEN_SIGN_UKI inválido: $CIZEN_SIGN_UKI (use yes, no o auto)."; exit 1 ;;
esac

info "cizen-uki-sync — objetivo: $(uki_efi_name)"
info "pkgbase: $CIZEN_UKI_PKGBASE | suffix: $CIZEN_UKI_SUFFIX"
resolve_sign_request

kernel="$(find_cizen_installed_kernel || true)"
if [ -z "$kernel" ] || [ ! -s "$kernel" ]; then
  fatal "No encontré ningún kernel Cizen instalado (buscado: /usr/lib/modules/*$CIZEN_UKI_SUFFIX/vmlinuz y /boot/vmlinuz-*$CIZEN_UKI_SUFFIX)."
fi
ok "Kernel Cizen instalado: $kernel"

cmdline_file="$(prepare_cmdline_file)" || fatal "No pude preparar la línea de comandos de arranque."
info "cmdline: $(<"$cmdline_file")"

targets=()
while IFS= read -r t; do
  [ -n "$t" ] && targets+=("$t")
done < <(find_uki_targets "$(uki_efi_name)" || true)

if [ "${#targets[@]}" -eq 0 ]; then
  esp="$(detect_esp_root 2>/dev/null || true)"
  if [ -z "$esp" ]; then
    rm -f "$cmdline_file"
    fatal "No encontré una partición EFI montada ni $(uki_efi_name) en el ESP; no hay nada que actualizar."
  fi
  targets=("$esp/EFI/Linux/$(uki_efi_name)")
fi

if [ "$DRY_RUN" = 1 ]; then
  info "Kernel:  $kernel"
  info "Objetivos:"
  for t in "${targets[@]}"; do
    printf '  - %s\n' "$t"
  done
  info "(modo --dry-run: no se escribe nada)"
  rm -f "$cmdline_file"
  exit 0
fi

# Antes de tocar el ESP: el preset de mkinitcpio es el otro productor de esta
# UKI (hook 90-mkinitcpio-install al instalar el kernel, y `mkinitcpio -P` con
# cualquier actualización de /usr/lib/initcpio/*). Se le recorta la UKI para que
# la próxima transacción de pacman no vuelva a pisar lo que escribimos aquí.
cizen_uki_claim_preset

tmp="$(mktemp /tmp/cizen-uki.XXXXXX)" || {
  rm -f "$cmdline_file"
  fatal "No pude crear el temporal de la UKI."
}
trap 'rm -f "$tmp" "$cmdline_file"' EXIT

# Ruta del initramfs que ukify integra como sección .initrd. Tras una UKI
# escrita y verificada, el archivo suelto sobra (systemd-boot solo usa el .efi)
# y se elimina salvo CIZEN_UKI_KEEP_INITRAMFS=1 (override, p.ej. para arranque
# directo del vmlinuz). Solo se borra si realmente quedó embebido (ukify), nunca
# con el fallback objcopy ni en --dry-run.
embedded_initrd=""

if ! build_uki "$kernel" "$cmdline_file" "$tmp"; then
  fatal "No pude generar la UKI ($(uki_efi_name)). Instala ukify (systemd-ukify) o binutils y verifica /usr/lib/systemd/boot/efi/linuxx64.efi.stub."
fi
ok "UKI generada en temporal."

# Lo que se va a escribir tiene que ser exactamente lo que se ha validado: la
# sección .initrd de la UKI debe medir lo mismo que el initramfs, y sin
# initramfs el arranque degradado ya ha quedado avisado. Con un .initrd que no
# cuadra no se escribe nada: es mejor quedarse con la UKI anterior.
if ! cizen_uki_verify_image "$tmp" "$INITRAMFS_PATH"; then
  fatal "La UKI generada no supera la verificación de la sección .initrd: no la escribo en el ESP."
fi

cleanup_uki_variants

for t in "${targets[@]}"; do
  log "Actualizando .efi: $t"
  if ! "${SUDO[@]}" mkdir -p "$(dirname "$t")"; then
    warn "No pude crear $(dirname "$t"); continúo con el siguiente."
    continue
  fi
  if "${SUDO[@]}" cp -f "$tmp" "$t.cizen-tmp" && "${SUDO[@]}" mv -f "$t.cizen-tmp" "$t"; then
    ok "UKI escrita (atómica): $t"
  elif "${SUDO[@]}" cp -f "$tmp" "$t"; then
    ok "UKI escrita (directa): $t"
  else
    warn "No se pudo actualizar $t"
  fi
done

"${SUDO[@]}" sync

if ! targets_are_current; then
  fatal "La UKI no quedó actualizada después de escribir en el objetivo."
fi

# Firma de la UKI con sbctl (Secure Boot): tras escribir, se firma y verifica
# cada objetivo. Con SB activo una UKI sin firmar no arrancaría: fail-safe.
if [ "$DO_SIGN" = true ]; then
  if ! sbctl_keys_present; then
    if secure_boot_active; then
      fatal "Secure Boot ACTIVO y sin claves sbctl generadas (sbctl create-keys/enroll-keys): no se puede firmar la UKI."
    fi
    warn "No hay claves sbctl (sudo sbctl create-keys): la UKI queda sin firmar por ahora."
  elif ! sign_uki_targets "${targets[@]}"; then
    if secure_boot_active; then
      fatal "La UKI no quedó firmada con Secure Boot ACTIVO: el sistema no arrancaría. Revisa sbctl (sbctl sign / sbctl enroll-keys --microsoft)."
    fi
    fatal "No se pudo firmar la UKI (sbctl sign/verify falló)."
  fi
fi

# Saneado final de la BD de sbctl, INDEPENDIENTEMENTE de si se acaba de firmar:
# es lo que evita que el próximo 'pacman -Syu' muera en el hook zzz-sbctl.hook
# ("failed signing ...: does not exist") por una UKI +N que systemd-bless-boot
# renombró, por una variante que cleanup_uki_variants acaba de borrar o por
# cualquier otra entrada huérfana que hubiera de un build anterior.
sbctl_prune_stale

if [ -n "$embedded_initrd" ] && [ "$CIZEN_UKI_KEEP_INITRAMFS" != "1" ] && [ -f "$embedded_initrd" ]; then
  if "${SUDO[@]}" rm -f "$embedded_initrd"; then
    ok "Initramfs integrado en la UKI; residuo eliminado: $embedded_initrd"
  else
    warn "Initramfs integrado, pero no pude eliminarlo: $embedded_initrd"
  fi
fi

ok "Sincronización de UKI completada."
